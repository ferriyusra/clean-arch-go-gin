# ---- Server ----------------------------------------------------------------
SERVER_HOST=
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
# How long the process waits for in-flight requests on SIGTERM.
SERVER_SHUTDOWN_TIMEOUT=10s
# Per-request deadline applied by the timeout middleware.
SERVER_REQUEST_TIMEOUT=10s

# ---- Database --------------------------------------------------------------
# sqlite | postgres. Anything else is rejected at startup rather than silently
# falling back to a local file.
DATABASE_TYPE=sqlite
DATABASE_DSN=dev.db
# Postgres example:
# DATABASE_TYPE=postgres
# DATABASE_DSN=host=localhost user=app password=app dbname=app port=5432 sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=5m
# silent | error | warn | info. GORM's own default (info) logs every statement.
DATABASE_LOG_LEVEL=warn

# ---- Logging ---------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# ---- Auth ------------------------------------------------------------------
# Required when DEV_MODE=false. Minimum 32 characters, and the two JWT secrets
# must differ. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CSRF_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
# How long a CSRF token stays valid. They are stateless and cannot be revoked,
# so a lifetime is the only thing that limits a leaked one.
CSRF_TOKEN_TTL=12h
# How often expired refresh-token rows are swept. 0 disables the sweep.
REFRESH_TOKEN_PURGE_INTERVAL=1h
# Comma separated. "*" is rejected because credentials are allowed.
ALLOWED_ORIGINS=http://localhost:5173

# ---- Security --------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
MAX_REQUEST_BODY_BYTES=1048576
# Comma separated CIDRs or IPs. Empty means trust no proxy, so ClientIP is the
# direct peer rather than a spoofable X-Forwarded-For header.
TRUSTED_PROXIES=

# ---- Redis (reserved; nothing reads these yet) ------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---- Tracing (OpenTelemetry) -----------------------------------------------
# Off by default. When enabled, every request produces a span, database queries
# become child spans, and the trace id appears in logs and in error responses.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=clean-arch-go-gin
# Overridden by the version stamped into the binary at build time unless set.
OTEL_SERVICE_VERSION=dev
OTEL_ENVIRONMENT=production
# otlp sends to a collector; console prints spans to stdout, which is enough to
# see tracing working without running one.
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Must be false outside DEV_MODE for a non-loopback collector, or startup fails:
# spans carry request metadata and should not cross a network in the clear.
OTEL_EXPORTER_OTLP_INSECURE=true
# Fraction of traces kept when the request arrives with no sampling decision.
# 1.0 keeps everything; lower it under real traffic.
OTEL_TRACES_SAMPLER_ARG=1.0

# ---- Development -----------------------------------------------------------
# true substitutes throwaway secrets, drops the cookie Secure flag, and puts
# gin in debug mode.
DEV_MODE=false
