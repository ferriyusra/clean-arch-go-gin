# Copy to .env and adjust. Every variable below is optional — the value shown is
# the built-in default, except for the JWT secrets, which are required whenever
# DEV_MODE is false.

# ---- Server ----
# SERVER_HOST empty binds on all interfaces.
SERVER_HOST=
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
# How long in-flight requests get to finish after SIGTERM.
SERVER_SHUTDOWN_TIMEOUT=10s

# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For. Leave empty to
# trust none, so the client IP is the direct peer. Only fill this in when the app
# genuinely sits behind a proxy you control — otherwise callers can spoof their IP
# and slip past the rate limiter.
TRUSTED_PROXIES=

# debug | info | warn | error. Empty means debug in dev mode, info otherwise.
LOG_LEVEL=

# ---- Database ----
# sqlite (default) or postgres.
DATABASE_TYPE=sqlite
# SQLite: a file path. Postgres: a connection string, e.g.
#   host=localhost user=postgres password=postgres dbname=app port=5432 sslmode=disable
DATABASE_DSN=dev.db
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=5m
# Runs GORM AutoMigrate on boot. Convenient in development, but AutoMigrate only
# adds columns and indexes — it never alters or drops them. Set this to false in
# production and manage the schema with a real migration tool.
DATABASE_AUTO_MIGRATE=true

# ---- Auth ----
# Required when DEV_MODE=false: at least 32 characters each, and they must differ
# from each other. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# The `iss` claim on issued tokens.
JWT_ISSUER=boilerplate-golang-gin
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
# Comma-separated origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:5173

# ---- Rate limiting (the /api/auth/* endpoints, per client IP) ----
# Set RATE_LIMIT_LOGIN_ATTEMPTS to 0 to disable limiting entirely.
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW=1m

# ---- Development mode ----
# true relaxes startup: fallback JWT secrets, Gin debug mode, SQL query logging.
# Never enable this in production.
DEV_MODE=false
