# ---- Server ----------------------------------------------------------------
SERVER_HOST=
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
# How long the process waits for in-flight requests on SIGTERM.
SERVER_SHUTDOWN_TIMEOUT=10s
# Per-request deadline applied by the timeout middleware.
SERVER_REQUEST_TIMEOUT=10s

# ---- Database --------------------------------------------------------------
# sqlite | postgres. Anything else is rejected at startup rather than silently
# falling back to a local file.
DATABASE_TYPE=sqlite
DATABASE_DSN=dev.db
# Postgres example:
# DATABASE_TYPE=postgres
# DATABASE_DSN=host=localhost user=app password=app dbname=app port=5432 sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=5m
# silent | error | warn | info. GORM's own default (info) logs every statement.
DATABASE_LOG_LEVEL=warn

# ---- Logging ---------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# ---- Auth ------------------------------------------------------------------
# Required when DEV_MODE=false. Minimum 32 characters, and the two JWT secrets
# must differ. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CSRF_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
# Comma separated. "*" is rejected because credentials are allowed.
ALLOWED_ORIGINS=http://localhost:5173

# ---- Security --------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
MAX_REQUEST_BODY_BYTES=1048576
# Comma separated CIDRs or IPs. Empty means trust no proxy, so ClientIP is the
# direct peer rather than a spoofable X-Forwarded-For header.
TRUSTED_PROXIES=

# ---- Redis (reserved; nothing reads these yet) ------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---- Development -----------------------------------------------------------
# true substitutes throwaway secrets, drops the cookie Secure flag, and puts
# gin in debug mode.
DEV_MODE=false
